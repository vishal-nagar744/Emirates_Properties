# Copy to server/.env and set real values. Do not commit server/.env.

PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/emirates_properties
PUBLIC_API_URL=http://127.0.0.1:4000

# Browser origins allowed to call the API. Localhost ports are also allowed
# while ALLOW_LOCALHOST_CORS=true.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
ALLOW_LOCALHOST_CORS=true

SESSION_TTL_HOURS=12
REMEMBER_TTL_DAYS=7

# Used only the first time the admin account is created.
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Emirates Admin
ADMIN_MOBILE=+971 4 000 0001
